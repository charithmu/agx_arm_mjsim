<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper">

  <xacro:arg name="initial_positions_file"
             default="$(find agx_arm_mjsim)/config/initial_positions.yaml"/>
  <xacro:arg name="headless" default="false"/>
  <xacro:arg name="effector_type" default="agx_gripper"/>
  <xacro:arg name="revo2_type" default="left"/>
  <xacro:arg name="tcp_offset_xyz" default="0 0 0.1358"/>
  <xacro:arg name="tcp_offset_rpy" default="0 0 0"/>

  <!-- Kinematics, visuals, collisions + tcp_link (shared with gzsim and MoveIt) -->
  <xacro:include filename="$(find agx_arm_description)/agx_arm_urdf/agx_arm_with_tcp.xacro"/>
  <xacro:agx_arm_with_tcp
    arm_type="piper"
    effector_type="$(arg effector_type)"
    revo2_type="$(arg revo2_type)"
    tcp_offset_xyz="$(arg tcp_offset_xyz)"
    tcp_offset_rpy="$(arg tcp_offset_rpy)"
  />

  <!-- ros2_control hardware block (MujocoSystemInterface) -->
  <xacro:include filename="$(find agx_arm_mjsim)/urdf/piper_mjsim.ros2_control.xacro"/>
  <xacro:piper_ros2_control
    name="MujocoSystem"
    initial_positions_file="$(arg initial_positions_file)"
    headless="$(arg headless)"/>

</robot>
